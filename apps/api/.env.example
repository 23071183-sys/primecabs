# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Local database started by `npm run db:start` (port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/primecabs
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/primecabs_test

# Long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=
OTP_HASH_SECRET=
FILE_URL_SECRET=
# 64 hex characters, used to encrypt driver bank account numbers
DATA_ENCRYPTION_KEY=

# Comma-separated origins allowed to call the API from a browser (admin portal)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# First super admin, created by the seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true = also create demo drivers, a demo ride and demo admins for each role
SEED_DEMO=true

# SMS: fake (prints the OTP in the API log) or msg91
SMS_PROVIDER=fake
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Payments: fake (no money moves) or razorpay (use TEST keys first)
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Document storage: local (apps/api/storage) for development
STORAGE_PROVIDER=local
PUBLIC_BASE_URL=http://localhost:4000
